# ==============================================================================
# PayGuard Backend Environment Configuration (.env.example)
# ==============================================================================

NODE_ENV=development
PORT=5000

# Database (MongoDB Connection URI)
MONGODB_URI=mongodb://localhost:27017/payguard

# Security & JSON Web Tokens (Change in Production!)
JWT_SECRET=payguard_dev_secret_key_123456789_enterprise_secure
JWT_EXPIRES_IN=7d

# CORS & Allowed Origins (Comma-separated or * for development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Python ML Microservice Bridge URL
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=2000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug
